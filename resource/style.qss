 *
 * 颜色使用 @token 引用设计变量，定义见 src/widgets/jy_theme.cpp
 * 间距以 4px 为单位，圆角统一为 4px（控件）/ 6px（弹出层）
 */

/* =============================================================================
   全局样式
   ============================================================================= */
QWidget {
    color: @text;
    background-color: @bg-panel;
    selection-background-color: @accent;
    selection-color: @text-on-accent;
    font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QToolTip {
    color: @text;
    background-color: @bg-elevated;
    border: 1px solid @border-strong;
    border-radius: 4px;
    padding: 4px 8px;
}

/* =============================================================================
   按钮
   ============================================================================= */
QPushButton {
    min-height: 20px;
    padding: 4px 12px;
    color: @text;
    background: @bg-hover;
    border: 1px solid transparent;
    border-radius: 4px;
}

QPushButton:hover {
    background: @bg-active;
}

QPushButton:pressed {
    background: @border-strong;
}

QPushButton:checked {
    color: @text-on-accent;
    background: @accent-subtle;
    border-color: @accent;
}

QPushButton:focus {
    border-color: @accent;
}

QPushButton:disabled {
    color: @text-disabled;
    background: @bg-panel;
    border-color: @border;
}

/* 主按钮：setProperty("primary", true) */
QPushButton[primary="true"] {
    color: @text-on-accent;
    background: @accent;
}

QPushButton[primary="true"]:hover {
    background: @accent-hover;
}

QPushButton[primary="true"]:pressed {
    background: @accent-pressed;
}

QPushButton[primary="true"]:disabled {
    color: @text-disabled;
    background: @bg-hover;
}

/* 图标按钮：setFlat(true) */
QPushButton:flat {
    min-width: 20px;
    padding: 4px;
    border: none;
    background: transparent;
}

QPushButton:flat:hover {
    background: @bg-hover;
}

QPushButton:flat:pressed {
    background: @bg-active;
}

QPushButton::menu-indicator {
    image: none;
    width: 0;
}

/* =============================================================================
   活动栏（左侧导航）
   ============================================================================= */
QToolBar {
    background: @bg-panel;
    border: none;
    border-right: 1px solid @border;
    spacing: 0;
    padding: 4px 0;
}

QToolBar QWidget {
    background: transparent;
}

QToolBar QPushButton {
    min-width: 44px;
    min-height: 40px;
    padding: 0;
    margin: 0;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0;
    background: transparent;
}

QToolBar QPushButton:hover {
    background: transparent;
}

QToolBar QPushButton:checked {
    border-left: 2px solid @accent;
    background: transparent;
}

QToolBar QPushButton:disabled {
    background: transparent;
}

/* =============================================================================
   状态栏
   ============================================================================= */
QStatusBar {
    background: @bg-panel;
    border-top: 1px solid @border;
    color: @text-muted;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: @text-muted;
    padding: 2px 8px;
}

/* =============================================================================
   文本编辑器
   ============================================================================= */
QPlainTextEdit,
QTextEdit {
    background-color: @bg-base;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: @accent-subtle;
    selection-color: @text;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 14px;
}

QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: @accent;
}

QPlainTextEdit:disabled,
QTextEdit:disabled {
    color: @text-disabled;
}

QTextBrowser {
    background-color: @bg-base;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 8px;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 13px;
}

/* =============================================================================
   输入框
   ============================================================================= */
QLineEdit {
    min-height: 20px;
    padding: 4px 8px;
    background: @bg-input;
    color: @text;
    border: 1px solid @border-strong;
    border-radius: 4px;
}

QLineEdit:hover {
    border-color: @text-disabled;
}

QLineEdit:focus {
    border-color: @accent;
}

QLineEdit:disabled {
    color: @text-disabled;
    border-color: @border;
}

QLineEdit:read-only {
    color: @text-muted;
    background: @bg-panel;
}

/* =============================================================================
   下拉框
   ============================================================================= */
QComboBox {
    min-height: 20px;
    padding: 4px 28px 4px 8px;
    background: @bg-input;
    color: @text;
    border: 1px solid @border-strong;
    border-radius: 4px;
}

QComboBox:hover {
    border-color: @text-disabled;
}

QComboBox:focus,
QComboBox:on {
    border-color: @accent;
}

QComboBox:disabled {
    color: @text-disabled;
    border-color: @border;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-down-muted.png);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background: @bg-elevated;
    color: @text;
    border: 1px solid @border-strong;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 2px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background: @accent;
    color: @text-on-accent;
}

/* =============================================================================
   标签
   ============================================================================= */
QLabel {
    color: @text;
    background: transparent;
}

QLabel[class="title"] {
    font-size: 15px;
    font-weight: 600;
}

QLabel[class="subtitle"] {
    font-weight: 500;
    color: @text-muted;
}

QLabel[class="caption"] {
    font-size: 12px;
    color: @text-muted;
}

/* =============================================================================
   分组框：仅保留标题与上分割线，弱化边框
   ============================================================================= */
QGroupBox {
    font-weight: 600;
    color: @text;
    border: none;
    border-top: 1px solid @border;
    margin-top: 16px;
    padding-top: 8px;
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 0 4px 0 0;
    color: @text-muted;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
}

QGroupBox::indicator:unchecked {
    image: url(:/icons/chevron-right-muted.png);
}

QGroupBox::indicator:checked {
    image: url(:/icons/chevron-down-muted.png);
}

/* =============================================================================
   分割条
   ============================================================================= */
QSplitter::handle {
    background: @border;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background: @accent;
}

/* =============================================================================
   菜单
   ============================================================================= */
QMenuBar {
    background: @bg-panel;
    color: @text;
    border-bottom: 1px solid @border;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: @bg-hover;
}

QMenu {
    background: @bg-elevated;
    color: @text;
    border: 1px solid @border-strong;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 8px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: @accent;
    color: @text-on-accent;
}

QMenu::item:disabled {
    color: @text-disabled;
    background: transparent;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: @border-strong;
    margin: 4px 8px;
}

/* =============================================================================
   列表 / 树
   ============================================================================= */
QListWidget,
QTreeWidget,
QListView {
    background-color: @bg-panel;
    color: @text;
    border: none;
    outline: none;
    padding: 0;
    alternate-background-color: @bg-alt;
}

QListWidget::item,
QTreeWidget::item {
    min-height: 24px;
    padding: 0 4px;
    border: none;
    border-radius: 4px;
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background: @bg-hover;
}

QListWidget::item:selected,
QTreeWidget::item:selected {
    background: @accent-subtle;
    color: @text;
}

QListWidget::item:selected:active,
QTreeWidget::item:selected:active {
    background: @accent;
    color: @text-on-accent;
}

QListWidget::item:disabled,
QTreeWidget::item:disabled {
    color: @text-disabled;
}

QTreeWidget::branch {
    background: transparent;
}

QTreeWidget::branch:has-children:closed {
    image: url(:/icons/chevron-right-muted.png);
}

QTreeWidget::branch:has-children:open {
    image: url(:/icons/chevron-down-muted.png);
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background: @bg-panel;
    color: @text-muted;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid @border;
    font-weight: 500;
}

/* =============================================================================
   进度条 / 进度对话框
   ============================================================================= */
QProgressBar {
    min-height: 4px;
    max-height: 4px;
    border: none;
    border-radius: 2px;
    background: @bg-hover;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: @accent;
    border-radius: 2px;
}

QProgressDialog {
    background: @bg-elevated;
}

QProgressDialog QProgressBar {
    margin: 8px;
}

/* =============================================================================
   滚动条：细条、无箭头，悬停时加深
   ============================================================================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: @bg-active;
    min-height: 32px;
    margin: 2px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: @bg-active;
    min-width: 32px;
    margin: 2px;
    border-radius: 3px;
}

QScrollBar::handle:hover {
    background: @border-strong;
}

QScrollBar::handle:pressed {
    background: @text-disabled;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* =============================================================================
   对话框
   ============================================================================= */
QDialog,
QMessageBox {
    background: @bg-panel;
}
