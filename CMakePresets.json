{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "prebuilt-vcpkg",
      "hidden": true,
      "description": "Download prebuilt dependencies from Jelatine/JellyCAD-vcpkg releases",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "JELLYCAD_PREBUILT_VCPKG": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (prebuilt vcpkg)",
      "inherits": "prebuilt-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (prebuilt vcpkg)",
      "inherits": "prebuilt-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ]
}
